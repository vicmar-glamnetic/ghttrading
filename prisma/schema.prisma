// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  image         String?
  coverImage    String?
  password      String?
  bio           String?
  location      String?
  website       String?
  birthday      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  role               String   @default("member") // admin | coach | member
  approved           Boolean  @default(false)     // admin approval gate for new sign-ups
  accmMember         Boolean  @default(true)      // ACCM member (free) vs other broker ($5)
  accmNumber         String?  @unique              // ACCM (AC Capital Market) account number — required from members before using the app; must be unique

  // Identity. ACCM members must display "<Name> - <accmNumber>" so anyone in the
  // community can tie a post to a real trading account. `name` holds that public
  // display name; `realName` is the legal name behind it and is NEVER shown to
  // other members — only to staff and the owner (see identityFor() in lib/identity).
  realName           String?
  // Proof-of-account review. accmProofUrl is a Vercel Blob URL, deleted as soon
  // as staff decides, so an ID screenshot doesn't sit on a public URL forever.
  accmProofUrl       String?
  accmVerifyStatus   String   @default("unverified") // unverified | pending | verified | rejected
  accmProofAt        DateTime?  // when the member submitted proof
  accmVerifiedAt     DateTime?
  accmVerifiedById   String?    // staff user id that decided
  accmRejectReason   String?
  subscriptionStatus String   @default("free")
  stripeCustomerId   String?
  stripeSubId        String?
  paypalSubscriptionId String?
  paymentRef         String?   // crypto tx hash / manual payment reference (pending review)
  trialEndsAt        DateTime? // free-trial window for non-ACCM (other broker) members
  subscriptionEnd    DateTime?
  sessionToken       String?  @unique  // single-session enforcement
  lastSeenAt         DateTime? // heartbeat from the open app; drives the online dot

  accounts          Account[]
  authenticators    Authenticator[]
  sessions          Session[]
  posts             Post[]
  comments          Comment[]
  likes             Like[]
  notifications     Notification[] @relation("NotificationReceiver")
  sentNotifications Notification[] @relation("NotificationSender")
  following         Follow[]       @relation("Following")
  followers         Follow[]       @relation("Followers")
  sentRequests      FriendRequest[] @relation("SentRequests")
  receivedRequests  FriendRequest[] @relation("ReceivedRequests")
  journalEntries    JournalEntry[]
  tradeIdeas        TradeIdea[]
  educatorVideos    EducatorVideo[]
  chatMessages      ChatMessage[]   @relation("ChatMessages")
  convosAsUser1     Conversation[]  @relation("ConvUser1")
  convosAsUser2     Conversation[]  @relation("ConvUser2")
  sentDMs           DirectMessage[] @relation("SentDMs")
  ownedGroups       Group[]         @relation("GroupOwner")
  groupMemberships  GroupMember[]
  ownedPages        Page[]          @relation("PageOwner")
  pageFollows       PageFollow[]
  pushSubscriptions PushSubscription[]
  priceAlerts       PriceAlert[]
  enrollments       Enrollment[]
  lessonProgress    LessonProgress[]
  coachingOffers    CoachingOffer[]   @relation("CoachingOffers")

  // Trader prefs
  acctBalance       Float?    // saved account size for auto position-sizing
  acctRiskPct       Float?    // saved risk % per trade
  shareStats        Boolean   @default(false) // opt in to the member leaderboard

  // Risk guardrails. Risk-per-trade (above) is the easy half; what actually
  // empties accounts is the revenge-trading spiral after two losses.
  // Both null = no guardrail. Opt-in, and advisory — never blocks the app.
  dailyLossLimit    Float?    // warn once today's realised P&L is <= -this (USD)
  maxTradesPerDay   Int?      // warn once this many trades are journalled today

  @@index([lastSeenAt])
  @@index([accmVerifyStatus])
  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Post {
  id        String   @id @default(cuid())
  content   String
  images    String[] @default([])
  feeling   String?
  location  String?
  privacy   String   @default("public")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId  String
  groupId   String?
  pageId    String?
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group     Group?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  page      Page?     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  comments  Comment[]
  likes     Like[]

  @@index([authorId, createdAt])
  @@index([privacy, createdAt])
  @@index([groupId, createdAt])
  @@index([pageId, createdAt])
  @@map("posts")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId  String
  postId    String
  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  likes     Like[]
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")

  @@index([postId, createdAt])
  @@map("comments")
}

model Like {
  id        String   @id @default(cuid())
  type      String   @default("like")
  createdAt DateTime @default(now())

  userId    String
  postId    String?
  commentId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@map("likes")
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("follows")
}

model FriendRequest {
  id         String   @id @default(cuid())
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  senderId   String
  receiverId String
  sender     User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@map("friend_requests")
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  receiverId String
  senderId   String?
  receiver   User    @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User?   @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([receiverId, read, createdAt])
  @@map("notifications")
}

model JournalEntry {
  id        String   @id @default(cuid())
  title     String?
  content   String
  mood      String?
  pinned    Boolean  @default(false) // pinned entries sort to the top of the list
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Trade metadata (all optional — an entry can be a pure note)
  tradedAt  DateTime?   // the day the trade was placed; drives the calendar
  symbol    String?     // e.g. XAUUSD
  direction String?     // buy | sell
  result    String?     // win | loss | breakeven
  pnl       Float?      // realised profit/loss; derived from the prices below when they're all present, else hand-typed

  // Trade prices. When entry + exit + lots are all set, pnl and rMultiple are
  // computed from them (see lib/journal.ts deriveTrade) and the P&L field locks.
  entryPrice  Float?
  exitPrice   Float?
  stopPrice   Float?    // needed for rMultiple — no stop, no R
  targetPrice Float?    // planned target; exit vs target shows winners cut early
  lots        Float?
  rMultiple   Float?    // result in units of risk; null unless derived with a stop
  setup       String?   // value from lib/setups.ts SETUPS
  chartUrl    String?   // Vercel Blob URL of the trade's chart screenshot

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, pinned, createdAt])
  @@index([authorId, tradedAt])
  @@index([authorId, setup])
  @@map("journal_entries")
}

// Chat room messages. room = "community" or "coach:<coachId>".
model ChatMessage {
  id        String   @id @default(cuid())
  room      String   @default("community")
  content   String
  authorId  String
  author    User     @relation("ChatMessages", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([room, createdAt])
  @@map("chat_messages")
}

// 1-on-1 direct message conversation (user1Id < user2Id canonical order).
model Conversation {
  id            String   @id @default(cuid())
  user1Id       String
  user2Id       String
  user1         User     @relation("ConvUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2         User     @relation("ConvUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  user1ReadAt   DateTime?
  user2ReadAt   DateTime?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  messages      DirectMessage[]

  @@unique([user1Id, user2Id])
  @@index([user1Id, lastMessageAt])
  @@index([user2Id, lastMessageAt])
  @@map("conversations")
}

model DirectMessage {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation("SentDMs", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("direct_messages")
}

// Email verification codes for new sign-ups (anti-bot / real-email check).
model EmailVerificationCode {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  expires   DateTime
  createdAt DateTime @default(now())

  @@map("email_verification_codes")
}

// A passkey (WebAuthn credential) — Face ID / Touch ID / Windows Hello sign-in.
//
// These are DISCOVERABLE credentials (resident keys): the private key is stored
// in the device's secure enclave along with the user handle, so signing in needs
// no e-mail typed at all — which also means the login screen can't be used to
// probe whether an address has an account here.
//
// The key material never reaches us. `credentialPublicKey` is the public half;
// the private half cannot leave the device and cannot be phished.
model Authenticator {
  id                   String    @id @default(cuid())
  credentialID         String    @unique   // base64url
  userId               String
  credentialPublicKey  String              // base64url
  counter              Int       @default(0)
  credentialDeviceType String    @default("singleDevice")
  credentialBackedUp   Boolean   @default(false)
  transports           String?             // comma-separated, e.g. "internal,hybrid"
  name                 String?             // friendly label, e.g. "iPhone"
  createdAt            DateTime  @default(now())
  lastUsedAt           DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("authenticators")
}

// Short-lived e-mail codes that re-confirm a sensitive account change. Separate
// from EmailVerificationCode (which is keyed by e-mail for sign-up) so a member
// mid-registration and a member changing their name never clash.
//
// The code is stored as a SHA-256 hash, never in the clear: a leaked DB row must
// not hand out a working code. `attempts` caps online guessing at MAX_CODE_ATTEMPTS
// and `lastSentAt` throttles resends.
model SecurityCode {
  id         String   @id @default(cuid())
  userId     String
  purpose    String   // "identity" — display name / real name / ACCM number change
  codeHash   String
  expires    DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, purpose])
  @@index([expires])
  @@map("security_codes")
}

// Single-row config for the live webinar (managed by coaches/admins).
model LiveWebinar {
  id        String   @id @default("default")
  mode      String   @default("webinar") // "webinar" = embedded stream, "room" = interactive Jitsi call
  title     String?
  embedUrl  String?
  roomName  String? // Jitsi room slug (used when mode = "room")
  isLive    Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("live_webinar")
}

model EducatorVideo {
  id        String   @id @default(cuid())
  title     String
  embedUrl  String                      // YouTube/Vimeo/etc URL
  educator  String?                     // display name of the educator
  category  String?                     // e.g. Getting Started, Technical Analysis
  createdAt DateTime @default(now())

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("educator_videos")
}

// A 1-on-1 coaching offer shown under Education. Members tap through to a
// direct message with the coach, who quotes pricing in the PM.
model CoachingOffer {
  id        String   @id @default(cuid())
  topic     String                       // what the sessions cover (may be multiline)
  coverage  String?                      // extra scope / schedule notes
  createdAt DateTime @default(now())

  coachId   String
  coach     User     @relation("CoachingOffers", fields: [coachId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("coaching_offers")
}

// Web Push subscription (for new-signal alerts). One row per browser/device.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("push_subscriptions")
}

// A member's price alert — push when the symbol crosses the target.
model PriceAlert {
  id          String   @id @default(cuid())
  userId      String
  symbol      String   // e.g. XAUUSD
  targetPrice Float    // for kind='zone' this is the zone midpoint, shown for reference only
  direction   String   // 'above' | 'below' (ignored for kind='zone')
  triggered   Boolean  @default(false)
  createdAt   DateTime @default(now())

  // 'price' = fire when price crosses targetPrice.
  // 'zone'  = fire when price trades into idea's entry zone (read live off the
  //           idea, so a coach editing the zone keeps the alert honest).
  kind        String   @default("price")
  ideaId      String?
  idea        TradeIdea? @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, ideaId], name: "one_zone_alert_per_signal")
  @@index([userId])
  @@index([symbol, triggered])
  @@map("price_alerts")
}

// Community sentiment on a signal: are members taking it or skipping it.
model SignalVote {
  id        String   @id @default(cuid())
  ideaId    String
  userId    String
  vote      String   // 'take' | 'skip'
  createdAt DateTime @default(now())
  @@unique([ideaId, userId])
  @@index([ideaId])
  @@map("signal_votes")
}

model TradeIdea {
  id           String   @id @default(cuid())
  symbol       String                       // e.g. BTC, XAUUSD
  direction    String                       // buy | sell
  entryLow     Float?                        // entry range low
  entryHigh    Float?                        // entry range high (== low for a single price)
  slLow        Float?                        // stop-loss range low
  slHigh       Float?                        // stop-loss range high
  takeProfits  Json     @default("[]")       // [{ price: number, pips?: number, hit?: boolean }]
  currentPrice Float?                        // optional live/quoted price; null renders as "--"
  status       String   @default("pending")  // pending | tp_hit | sl_hit
  entered      Boolean  @default(false)      // true once price has traded into the entry zone (gates TP auto-close)
  notes        String?
  chartUrl     String?                       // Vercel Blob URL of the marked-up chart behind the setup
  isPublic     Boolean  @default(false)      // shared to the community board vs. private
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  alerts       PriceAlert[]

  @@index([authorId, createdAt])
  @@index([isPublic, createdAt])
  @@map("trade_ideas")
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  image       String?
  coverImage  String?
  privacy     String   @default("public")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId  String
  owner    User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  GroupMember[]
  posts    Post[]

  @@index([privacy, createdAt])
  @@map("groups")
}

model GroupMember {
  role     String   @default("member")
  status   String   @default("active")
  joinedAt DateTime @default(now())

  userId  String
  groupId String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId, status])
  @@map("group_members")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

model Page {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   @default("general")
  image       String?
  coverImage  String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId   String
  owner     User         @relation("PageOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  followers PageFollow[]
  posts     Post[]

  @@index([category])
  @@map("pages")
}

model PageFollow {
  followedAt DateTime @default(now())

  followerId String
  pageId     String
  follower   User @relation(fields: [followerId], references: [id], onDelete: Cascade)
  page       Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([followerId, pageId])
  @@index([pageId])
  @@map("page_follows")
}

// A structured video course: sections of lessons, tracked per member.
model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  level       String   @default("beginner") // beginner | intermediate | advanced
  coverImage  String?
  published   Boolean  @default(true)
  order       Int      @default(0) // display order on the course grid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]

  @@index([published, order])
  @@map("courses")
}

model Lesson {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section   String // grouping header in the curriculum, e.g. "Foundations"
  title     String
  youtubeId   String // the 11-char id, not a full URL — the player builds the embed
  educator    String? // channel/creator credit
  summary     String?
  durationSec Int? // scraped best-effort; null renders as no runtime, never a guess
  order       Int // position across the whole course, not within the section
  createdAt   DateTime @default(now())

  progress LessonProgress[]

  @@index([courseId, order])
  @@map("lessons")
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@map("enrollments")
}

// One row per lesson a member has finished. Absence means not done — we never
// store "incomplete" rows, so un-completing is a delete.
model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}
